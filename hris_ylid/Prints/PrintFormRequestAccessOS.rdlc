      <Textbox Name="Textbox24">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Terms of Use :</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>a. By signing this form, the responsible use of User's Account is mine as a user.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>b. I give authorized to be audited at any time by the System Administrator or by Auditors appointed by the company.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>c. I promise I will keep all sensitive information (such as user and password and company data)</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>d. I am willing to be sanctioned if misuse on the use of this facility.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>e. If mutation occurs or inactive within a specified period then at the earliest opportunity I will report to the ITS HelpDesk</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Bookman Old Style</FontFamily>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>f. I will be responsible for all irregularities in user access for trainee/probation.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Bookman Old Style</FontFamily>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>I have read and agree to these Terms of Use User Access</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Bookman Old Style</FontFamily>
                  <FontSize>6pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Textbox24</rd:DefaultName>
        <Top>4.94667in</Top>
        <Left>0.27605in</Left>
        <Height>0.96875in</Height>
        <Width>6.54167in</Width>
